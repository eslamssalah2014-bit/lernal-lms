# ==============================================================================
# LERNAL LMS - MASTER ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Since 2026 - Production-Ready Multi-Cloud Architecture
# Frontend: Vercel | Backend: Render | Database & Auth: Supabase | Video: Bunny
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# Both NEXT_PUBLIC_* and VITE_* prefixes are supported for maximum compatibility
# ------------------------------------------------------------------------------
# Backend REST API Service Endpoint (e.g., https://lernal-lms-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api
BACKEND_URL=http://localhost:5000

# Supabase Public API Configuration (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Bunny.net Streaming Video CDN Hostname (From Bunny Stream -> Delivery Domain)
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=video.lernal.edu
VITE_BUNNY_CDN_HOSTNAME=video.lernal.edu

# ------------------------------------------------------------------------------
# 2. BACKEND REST API CONFIGURATION (Render / Node.js)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
JWT_SECRET=lernal_super_secret_jwt_key_since_2026_kid_safe
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & AUTHENTICATION (Database / Server-Side)
# ------------------------------------------------------------------------------
# Project URL (Same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Administrative Service Role Key (NEVER expose to frontend; used exclusively by backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. BUNNY.NET STREAMING (Video CDN & Token Authentication - Backend Only)
# ------------------------------------------------------------------------------
BUNNY_API_KEY=your-bunny-stream-api-key
BUNNY_LIBRARY_ID=12345
BUNNY_CDN_HOSTNAME=video.lernal.edu
BUNNY_TOKEN_AUTH_KEY=your-bunny-token-authentication-key
BUNNY_TOKEN_EXPIRATION_HOURS=6
