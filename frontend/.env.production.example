# ==============================================================================
# LERNAL LMS - VERCEL FRONTEND PRODUCTION ENVIRONMENT VARIABLES
# Framework: Vite + React (TypeScript)
# Configure these in: Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# 1. Backend REST API URL (Render Web Service)
# Provide your live Render backend URL (with or without /api - both work automatically)
# Example: https://lernal-lms-backend.onrender.com
VITE_API_URL=https://lernal-lms-backend.onrender.com

# 2. Supabase PostgreSQL & Auth Configuration
# Obtain from your Supabase Dashboard under: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Bunny.net Stream Video CDN Pull Zone Hostname (Optional)
# Example: video.lernal.edu or vz-xxxx.b-cdn.net
VITE_BUNNY_CDN_HOSTNAME=video.lernal.edu
