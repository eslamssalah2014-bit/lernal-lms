# ==============================================================================
# VERCEL DEPLOYMENT - ENVIRONMENT VARIABLES TEMPLATE
# Platform: Vercel (Frontend Client)
# Note: Supports both NEXT_PUBLIC_* and VITE_* variable naming formats
# ==============================================================================

# Backend REST API Service URL (Render deployment)
# Production example: https://lernal-lms-api.onrender.com
NEXT_PUBLIC_API_URL=
VITE_API_URL=
BACKEND_URL=

# Supabase Public Configuration (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL=
VITE_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=

# Bunny.net Streaming Video CDN Hostname
# Example: vz-xxxx.b-cdn.net or video.lernal.edu
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=
VITE_BUNNY_CDN_HOSTNAME=
