# ============================================================================
# LERNAL LMS - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: SINCE 2026
# Target Host: Render Web Service
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SERVER & RUNTIME (Render automatically assigns PORT; set NODE_ENV to production)
# ----------------------------------------------------------------------------
PORT=10000
NODE_ENV=production

# ----------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT
# The URL of your Vercel frontend deployment (supports comma-separated list)
# Example: https://lernal-lms.vercel.app or custom domain https://lernal.edu
# ----------------------------------------------------------------------------
FRONTEND_URL=https://lernal-lms.vercel.app

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# Strong secret used to sign and verify fallback server JWT tokens
# Generate with: openssl rand -base64 32
# ----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_64_character_hex_or_base64_string_since_2026

# ----------------------------------------------------------------------------
# 4. SUPABASE POSTGRESQL & AUTH
# Found in your Supabase Project Dashboard under Project Settings -> API
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Backend administrative key (Service Role) - NEVER expose on frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Supabase anonymous public key (used for user-scoped auth verification)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------------
# 5. BUNNY.NET STREAM CDN & VIDEO SECURITY
# Found in your Bunny.net Stream Dashboard -> Video Library -> API & Security
# ----------------------------------------------------------------------------
# Bunny Stream Video Library ID (e.g. 348921)
BUNNY_LIBRARY_ID=348921
# Bunny Stream API Key or Token Authentication Key (SHA256 Token Key)
BUNNY_API_KEY=your_bunny_api_key_here
BUNNY_TOKEN_AUTH_KEY=your_bunny_token_authentication_key_here
# Bunny Stream CDN Hostname (or custom pull-zone hostname, e.g. video.lernal.edu)
BUNNY_CDN_HOSTNAME=video.lernal.edu
# Signed video token validity duration in hours (default: 6)
BUNNY_TOKEN_EXPIRATION_HOURS=6
